# Copy to .env; never commit passwords or API keys.
DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus
TEST_DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus_test
# Docker Compose: use a random hex password (URL-safe).
POSTGRES_USER=focus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=focus
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8000
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0
# For a hosted PostgreSQL server with a publicly trusted certificate:
DATABASE_SSL=false
# Optional AI. Leave empty to use local text extraction/manual cards.
OPENAI_API_KEY=
OPENAI_MODEL=
