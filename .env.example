# Copy to .env; never commit passwords or API keys.
DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus
TEST_DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus_test
# Docker Compose: use a random hex password (URL-safe).
POSTGRES_USER=focus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=focus
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8000
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0
# For a hosted PostgreSQL server with a publicly trusted certificate:
DATABASE_SSL=false
# Prisma CLI migration connection (local default can reuse DATABASE_URL).
DIRECT_URL=
# Keep local until Supabase migrations and connection checks pass.
DATABASE_PROVIDER=local
# Find Project ref and connection URIs in Supabase Dashboard > Connect.
# Runtime: direct/session or transaction pooler. Migrations: direct/session port 5432.
SUPABASE_PROJECT_REF=
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
# Optional AI. Leave empty to use local text extraction/manual cards.
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI defaults when blank. KKU: https://gen.ai.kku.ac.th/upacth/api/v1
OPENAI_BASE_URL=
# responses for OpenAI; chat for KKU (auto-selected by hostname when blank)
OPENAI_API_MODE=
