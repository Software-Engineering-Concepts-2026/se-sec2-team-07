# Copy to .env; never commit passwords or API keys.
TEST_DATABASE_URL=postgresql://focus:change-me@localhost:5432/focus_test
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8000
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0
# Find Project ref and connection URIs in Supabase Dashboard > Connect.
# Runtime: direct/session or transaction pooler. Migrations: direct/session port 5432.
SUPABASE_PROJECT_REF=
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
# Optional AI. Leave empty to use local text extraction/manual cards.
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI defaults when blank. KKU: https://gen.ai.kku.ac.th/upacth/api/v1
OPENAI_BASE_URL=
# responses for OpenAI; chat for KKU (auto-selected by hostname when blank)
OPENAI_API_MODE=
