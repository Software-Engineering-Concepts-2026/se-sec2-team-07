{
  "name": "focus-flashcards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint src scripts tests *.js --max-warnings=0",
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch --env-file-if-exists=.env src/backend/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/backend/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js --supabase",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node --env-file-if-exists=.env node_modules/playwright/cli.js test",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration/*.test.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate",
    "db:check:supabase": "node --env-file-if-exists=.env scripts/migrate.js --supabase --check",
    "db:deploy:supabase": "node --env-file-if-exists=.env scripts/migrate.js --supabase",
    "db:migrate:test": "node --env-file-if-exists=.env scripts/migrate.js --test",
    "db:test:local": "node scripts/test-postgres.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css,html}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.{js,ts,json,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,html}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.{js,ts,json,yaml}\"",
    "test:smoke": "node --env-file-if-exists=.env scripts/smoke-test.js",
    "test:coverage": "node --env-file-if-exists=.env scripts/test-coverage.js",
    "test:coverage:unit": "node --env-file-if-exists=.env scripts/test-coverage.js unit",
    "test:coverage:integration": "node --env-file-if-exists=.env scripts/test-coverage.js integration",
    "test:coverage:browser": "node --env-file-if-exists=.env scripts/test-coverage.js browser",
    "test:coverage:report": "node scripts/test-coverage.js report"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/speed-insights": "^2.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "pdf-parse": "^2.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.1.0",
    "c8": "^12.0.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.1.0",
    "vite": "^7.3.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "shell-quote": "1.12.0"
  }
}
